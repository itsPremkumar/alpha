# Production environment template for Alpha
#
# Usage: copy to `.env` on the production host and fill in real secrets.
#   cp .env.production.example .env
#
# NEVER commit the filled-in `.env` (it is gitignored). Generate secrets with:
#   openssl rand -hex 32
#
# See docs/PRODUCTION.md for the full production runbook.

# ── Required secrets ─────────────────────────────────────────────────────────
# Session signing secret (REQUIRED for any login to work).
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# Shared internal Gateway auth token for multi-worker deployments.
# `make up` generates and persists this automatically; set it manually only
# when you run Gateway workers outside the bundled deploy script.
# AGENT_WORKSPACE_INTERNAL_AUTH_TOKEN=replace-me-with-openssl-rand-hex-32

# ── Production hardening ─────────────────────────────────────────────────────
# Disable Swagger UI, ReDoc, and the OpenAPI schema in production.
GATEWAY_ENABLE_DOCS=false

# Docker ingress. Defaults are loopback-only (127.0.0.1:2026), matching the
# local-trusted-environment deployment model — the agent can execute commands.
# Set BIND_HOST=0.0.0.0 ONLY behind your own TLS/auth front door or firewall,
# and complete first-run setup before the host becomes reachable.
# BIND_HOST=0.0.0.0
# PORT=2026

# Browser CORS allowlist for split-origin deployments (comma-separated exact
# origins). Leave unset when using the unified nginx endpoint.
# GATEWAY_CORS_ORIGINS=https://agent-workspace.example.com

# ── Database (recommended for production) ────────────────────────────────────
# Use postgres for shared/multi-worker deployments (see config.yaml
# database.backend). Memory/SQLite cannot coordinate multiple Gateway workers.
# DATABASE_URL=postgresql://alpha:replace-me@postgres:5432/alpha

# ── Model + tool keys (set the ones your config.yaml references) ────────────
# OPENAI_API_KEY=replace-me
# TAVILY_API_KEY=replace-me
# JINA_API_KEY=replace-me
# INFOQUEST_API_KEY=replace-me

# ── Tracing (optional, off by default) ───────────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=replace-me
# LANGSMITH_PROJECT=agent-workspace-prod

# ── Provisioner sandbox (only for provisioner/K8s sandbox mode) ─────────────
# PROVISIONER_API_KEY=replace-me-with-openssl-rand-hex-32

# Bytez (OpenAI-compatible unified API, https://docs.bytez.com)
# Free tier grants $1 of credits refreshed every 4 weeks.
BYTEZ_API_KEY=your-bytez-api-key

# Optional self-hosted Laya System One bearer token. Use the same value in the
# Laya server environment and config.yaml -> system_one.api_key. Leave unset
# only for a loopback-only, unauthenticated local server.
# LAYA_API_KEY=replace-with-a-long-random-token
