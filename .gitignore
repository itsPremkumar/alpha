# ─────────────────────────────────────────────────────────────────────────────
# Alpha — .gitignore
#
# Layout: OS noise → language caches → runtime state → operator config →
# secrets → build output → agent scratch → deployment artifacts.
#
# The runtime state directory is `.alpha/` (the `ALPHA_HOME` default). The
# pre-rename `.agent-workspace/` and `.agent_workspace_projects/` names are
# still listed so an in-place upgrade on a machine that has not yet migrated its
# data directory cannot accidentally stage megabytes of checkpoint/SQLite state.
# See docs/MIGRATION.md and `alpha migrate-state-dir`.
# ─────────────────────────────────────────────────────────────────────────────

# ── OS / editor noise ───────────────────────────────────────────────────────
# Test-harness scratch, not source. `rendered-honesty-markup.test.mjs` writes
# `__render_stub_<name>.mjs` into frontend/src/lib/ at module-eval time to fake
# the component's sibling imports; its own `process.on("exit")` hook now removes
# them, so anything still here is debris from a run that was killed outright.
# `.tmp/` holds throwaway fixture trees (docs-index tracked-root rebuilds, model
# probes) that are rebuilt on demand.
.tmp/
frontend/src/lib/__render_stub_*.mjs
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.local
# Generic log output
debug.log
*.log

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/lib/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# Virtual environments
.venv
venv/
ENV/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
*.tsbuildinfo

# ── Node / frontend ─────────────────────────────────────────────────────────
node_modules/
.pnpm-store
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# ── Alpha runtime state (the `.alpha` data directory) ──────────────────────
# Everything below is machine state, never source: checkpoints, the SQLite /
# Postgres-backed stores, per-user and per-thread directories, bot profiles,
# group rooms, memory, artifacts, and the runtime JSON lock files.
.alpha/
backend/.alpha/
.alpha_projects/
backend/.alpha_projects/

# Pre-rename state directories. Kept so upgrading a machine that has not yet
# run the state-dir migration never stages its data. Safe to drop once every
# deployment has migrated.
.agent-workspace/
backend/.agent-workspace/
.agent_workspace_projects/
backend/.agent_workspace_projects/

# Legacy/adjacent local project stores
.deerflow_projects/
.workbuddy-ai/
.omc/
web/

# Runtime lock + scratch files written next to state and configs
.*.json.lock
*.json.lock

# ── Operator-owned configuration (templates are tracked, real files are not) ─
# These hold $VAR references, per-deployment model choices, and MCP server
# credentials. `make config` / `make setup` generate them from the tracked
# *.example.* templates.
config.yaml
config.yaml.bak
extensions_config.json
mcp_config.json

# ── Secrets ─────────────────────────────────────────────────────────────────
# Real environment files are never tracked; the *.example templates are.
# Both patterns are unanchored, so they cover nested templates too, and the
# negations are repeated per directory for the same reason: `!.env.example`
# only un-ignores a root-level path once `.env.*` has matched a nested one.
.env
.env.*
!.env.example
!*/.env.example
!.env.production.example
!*/*.env.production.example
*.pem
*.key
secrets/

# ── Build output ────────────────────────────────────────────────────────────
# Docker image cache
docker/.cache/
# Docker build context
Dockerfile.*
!backend/Dockerfile
backend/Dockerfile.langgraph
# Next.js
/frontend/.next/
/frontend/out/
/frontend/test-results/
/frontend/playwright-report/
# Electron desktop shell
/electron/dist/
/electron/node_modules/
/electron/build/
# Playwright / MCP
.playwright-mcp
sandbox_image_cache.tar

# ── Project-local toolchain ─────────────────────────────────────────────────
# scripts/toolchain.ps1 pins uv's install dir, wheel cache, managed CPython and
# tool dir here, plus a project-local pnpm store, so nothing Alpha downloads
# lands in the user profile shared with other projects. It holds downloaded
# executables, so it must never be tracked.
.tools/
.tools
.npm-cache/

# ── Agent scratch space ─────────────────────────────────────────────────────
# A bug-hunt or audit session drops throwaway probes, captured route dumps and
# raw scan output in a dot-prefixed directory next to the code it is inspecting.
# That output is evidence while a defect is being measured and pure garbage once
# it is fixed, and some of it records this machine's absolute paths -- so it is
# never committable. Named per module rather than by a blanket `.*` rule, which
# would also swallow .github, .env and every other real dotfile.
.bughunt/
b2_entry.txt
.rename_engine.py
.rename_paths.py
.rename_verify.py
backend/.bughunt/
backend/.bughunt*
backend/.secaudit/
backend/.feaudit/
backend/.rt-audit/
frontend/.feaudit/
frontend/.fe-audit/
frontend/.rt-audit/

# ── Monocle / observability output ──────────────────────────────────────────
# Local file exporter for agent-observability traces.
.monocle/
backend/.monocle/

# ── Benchmark + measurement output ──────────────────────────────────────────
# Generated measurements, never source.
bench_results.jsonl
bench_optimized.jsonl
results.jsonl
backend/scripts/benchmark/*.jsonl
system_one_decisions*.jsonl
build/measure/**/_diag.py
build/measure/**/_budget_report.py

# ── Skills (public/ is committed; custom/ is per-user) ──────────────────────
skills/custom/*
# Managed integration packs are installed into the runtime home, not the repo.
.agent/
!AGENTS.md

# ── Deployment artifacts ────────────────────────────────────────────────────
.githooks/
# Generated by recovery/register_autostart.ps1 - contains this machine's paths.
recovery/autostart/*.vbs
.gstack/
.worktrees
.worktrees/
# Helm release/package output
deploy/helm/alpha/*.tgz
charts/



logs/
# Analysis battery outputs
analysis-reports/
.hypothesis/

# ── Editor / agent session scratch ───────────────────────────────────────────
# OpenCode writes this model catalog into the workspace root; it is a local
# session artifact, not project configuration. Project model settings live in
# config.yaml alone (see AGENTS.md, "config.yaml - the one file for every
# model setting"), so committing a second model file is actively harmful.
opencode-free-models.json


# Throwaway measurement venv and import-time dumps produced by agents.
# build/measure/prod-venv alone is ~324 MB across ~52,000 files; backend/.tmp holds
# profiling output. Neither is source. Without these, a bare 'git add -A' commits
# hundreds of megabytes of build debris.
build/measure/
backend/.tmp/

# ── Leftover audit-session debris (never source) ─────────────────────────────
# The same rule as "Agent scratch space" above, applied to what an audit leaves
# behind when the session ends without being tidied: one-off route scanners,
# manifest counters and import probes dropped beside the code they inspected,
# in the repo root, or in a scratch/ or tools/ directory created for that
# session. They hardcode this machine's absolute paths, they duplicate each
# other (scan_routes.py exists in 13 copies, one under the mangled path
# backend/app/gateway/backend/app/gateway/), and they are pure garbage once the
# defect they measured is fixed.
#
# Grouped by the directory they infest and by name prefix rather than one rule
# per file, because the next session will invent names this list has never
# seen. Directories with no tracked content (backend/tools/, backend/tmp_probe/,
# the mangled backend/app/gateway/backend/) are ignored wholesale.
#
# The prefix rules below are deliberately broad and DO match files this repo
# already committed -- root scan_routes.py, tmp_probe_*.py, _probe_drift.py and
# the older scratch/scan_* and scratch/probe_* scripts are all both tracked and
# ignored. That is intended and harmless: gitignore only decides whether an
# *untracked* file is offered for addition, so those committed files stay in
# the index, keep diffing, and keep appearing in `git status` when edited. What
# the rules actually change is that the next probe of that shape is never
# staged in the first place.

# Nested git worktrees. `.worktrees/` further up covers the other layout.
/.claude/worktrees/

# Root-level one-off probes, scanners and counters.
/.gate_runner.py
/.probe_*.py
/.ws_*
/_probe*.py
/_scan*.py
/tmp_*.py
/scan*.py
/route_scan*.py
/route_decorator_scan.py
/check_manifest.py
/compare_manifest.py
/count_manifest.py
/comprehensive_route_scan.py
/crosspkg_consumers.py
/gather_routes.py

# Gateway route/auth scans, plus the backend/ tree a scanner nested by mistake.
/backend/app/gateway/scan*
/backend/app/gateway/alpha_scan_routes.py
/backend/app/gateway/backend/
/backend/app/gateway/routers/scan_*.py
/backend/app/gateway/routers/routes.txt

# Probes dropped into the harness package itself, and their scratch directories.
/backend/packages/harness/alpha/_probe*.py
/backend/packages/harness/alpha/_core_probe.py
/backend/prove_*.py
/backend/tests/probe_harness_imports_app.py
/backend/tmp_probe/
/backend/tools/

# scratch/, tmp/ and .scratch/ keep their tracked scripts; only new debris goes.
/scratch/*.txt
/scratch/*_scan.py
/scratch/scan*.py
/scratch/check_*.py
/scratch/dbg*.py
/scratch/probe_*.py
/scratch/route_inventory*.py
/scratch/debug_inventory.py
/scratch/manifest_check.py
/scratch/print_decs.py
/scratch/router_prefix.py
/tmp/count_eng.py
/tmp/find_features.py
.scratch/lgcheck/

# A scanner copied into scripts/ next to the real scan_changed_blocking_io.py.
/scripts/scan_routes.py

# Windows reserved-name file created by a mistyped redirect, and backup copies
# written beside generated output (`*.bak` matches no tracked file).
/nul
*.bak
