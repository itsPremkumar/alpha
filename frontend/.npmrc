# Next.js standalone tracing resolves these through pnpm's .pnpm symlink farm.
# When they are only reachable as symlinks, `next build` fails while materialising
# the standalone tree with ENOENT on the symlink target (seen with @next/env and
# styled-jsx). Hoisting them gives the tracer a real directory to copy.
#
# EXTRA_STANDALONE_DEPS in electron/scripts/build-frontend.mjs also copies them
# post-build; this fixes the failure that happens *during* the build.
public-hoist-pattern[]=@next/env
public-hoist-pattern[]=styled-jsx

# Keep pnpm's content-addressable store inside the checkout. pnpm otherwise writes
# it to a per-user global (%LOCALAPPDATA%\pnpm\store on Windows, ~/.local/share/
# pnpm/store elsewhere) shared with every other project on the machine.
# A relative store-dir is resolved against this file's own directory, so the store
# lands in frontend/.pnpm-store wherever the repository is cloned. `.gitignore`
# already lists `.pnpm-store`; this is what makes that real.
store-dir=.pnpm-store

# Same reasoning for npm, which start.ps1 offers as the documented fallback when
# pnpm is unavailable. Relative to frontend/, i.e. <repo>/.npm-cache.
cache=../.npm-cache

